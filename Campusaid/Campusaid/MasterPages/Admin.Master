<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="Campusaid.MasterPages.AdminMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - CampusAid Admin Portal</title>
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Assets/CSS/campusaid.css") %>?v=20261101" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="formAdmin" runat="server">
        <asp:ScriptManager runat="server" />
        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo-row">
                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                        </div>
                        <span class="brand-text">CampusAid</span>
                    </div>
                    <span class="brand-portal-tag">ADMIN PORTAL</span>
                </div>

                <nav class="sidebar-nav">
                    <a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>" class="nav-link-item <%= IsActive("Dashboard.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg></span> Dashboard</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Reports.aspx") %>" class="nav-link-item <%= IsActive("Reports.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span> Reports</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Resources.aspx") %>" class="nav-link-item <%= IsActive("Resources.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg></span> Resources</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Users.aspx") %>" class="nav-link-item <%= IsActive("Users.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span> Users</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/EmergencyAlerts.aspx") %>" class="nav-link-item <%= IsActive("EmergencyAlerts.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12a5 5 0 0 1 10 0v4H7v-4z"/><path d="M5 20h14"/><path d="M12 4V2"/><path d="M4 4l2 2"/><path d="M20 4l-2 2"/></svg></span> Emergency Alerts</span>
                        <span class="nav-badge"><asp:Literal ID="litActiveAlertsCount" runat="server">3</asp:Literal></span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Announcements.aspx") %>" class="nav-link-item <%= IsActive("Announcements.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg></span> Announcements</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Admin/Settings.aspx") %>" class="nav-link-item <%= IsActive("Settings.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span> Settings</span>
                    </a>
                </nav>

                <div class="sidebar-user">
                    <div class="user-info">
                        <span class="user-name"><asp:Literal ID="litUserName" runat="server">Sudarshan Bhul</asp:Literal></span>
                        <span class="user-meta">System Administrator</span>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-sidebar-logout" OnClick="btnLogout_Click" CausesValidation="false" ToolTip="Sign Out">Log Out</asp:LinkButton>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="app-main">
                <header class="app-header">
                    <div class="header-left">
                        <button type="button" id="mobileSidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none me-2" aria-label="Toggle navigation">
                            <svg class="ca-icon ca-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
                        </button>
                        <asp:ContentPlaceHolder ID="HeaderTitleContent" runat="server">
                            <h1>Admin Command Center</h1>
                            <p>Comprehensive campus security oversight, live dispatch status, and utility analytics.</p>
                        </asp:ContentPlaceHolder>
                    </div>
                    <div class="header-right">
                        <span class="status-pill status-normal">
                            <span class="status-dot"></span>
                            SYSTEM STATUS: OPERATIONAL
                        </span>
                        <span class="hotline-badge">EMERGENCY LINE: EXT. 9111</span>
                    </div>
                </header>

                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/Assets/JS/campusaid.js") %>"></script>
</body>
</html>
