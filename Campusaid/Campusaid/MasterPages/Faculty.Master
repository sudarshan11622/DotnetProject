<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Faculty.Master.cs" Inherits="Campusaid.MasterPages.FacultyMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - CampusAid Faculty Portal</title>
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Assets/CSS/campusaid.css") %>?v=20261101" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="formFaculty" runat="server">
        <asp:ScriptManager runat="server" />
        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo-row">
                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                        </div>
                        <span class="brand-text">CampusAid</span>
                    </div>
                    <span class="brand-portal-tag">FACULTY PORTAL</span>
                </div>

                <nav class="sidebar-nav">
                    <a href="<%= ResolveUrl("~/Faculty/Dashboard.aspx") %>" class="nav-link-item <%= IsActive("Dashboard.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/></svg></span> Dashboard</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Faculty/EmergencyAlerts.aspx") %>" class="nav-link-item <%= IsActive("EmergencyAlerts.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></span> Emergency Alerts</span>
                        <span class="nav-badge"><asp:Literal ID="litActiveAlertsCount" runat="server">3</asp:Literal></span>
                    </a>
                    <a href="<%= ResolveUrl("~/Faculty/ReportIncident.aspx") %>" class="nav-link-item <%= IsActive("ReportIncident.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span> Report Incident</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Faculty/Reports.aspx") %>" class="nav-link-item <%= IsActive("Reports.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span> Reports</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Faculty/Resources.aspx") %>" class="nav-link-item <%= IsActive("Resources.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg></span> Resources</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Faculty/Profile.aspx") %>" class="nav-link-item <%= IsActive("Profile.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span> Profile</span>
                    </a>
                </nav>

                <div class="sidebar-user">
                    <div class="user-info">
                        <span class="user-name"><asp:Literal ID="litUserName" runat="server">Prof. Manab Roy</asp:Literal></span>
                        <span class="user-meta"><asp:Literal ID="litUserId" runat="server">Faculty ID: F-2840</asp:Literal></span>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-sidebar-logout" OnClick="btnLogout_Click" CausesValidation="false" ToolTip="Sign Out">Log Out</asp:LinkButton>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="app-main">
                <header class="app-header">
                    <div class="header-left">
                        <button type="button" id="mobileSidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none me-2" aria-label="Toggle navigation">
                            <svg class="ca-icon ca-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
                        </button>
                        <asp:ContentPlaceHolder ID="HeaderTitleContent" runat="server">
                            <h1>Faculty Control Hub</h1>
                            <p>Overview of campus emergency services, pending reports, and critical resources.</p>
                        </asp:ContentPlaceHolder>
                    </div>
                    <div class="header-right">
                        <span class="status-pill status-normal">
                            <span class="status-dot"></span>
                            CAMPUS STATUS: NORMAL
                        </span>
                        <span class="hotline-badge">FACULTY HOTLINE: EXT. 9111</span>
                    </div>
                </header>

                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/Assets/JS/campusaid.js") %>"></script>
</body>
</html>
