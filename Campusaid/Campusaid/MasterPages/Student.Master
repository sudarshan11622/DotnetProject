<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Student.Master.cs" Inherits="Campusaid.MasterPages.StudentMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - CampusAid Student Portal</title>
    <link href="<%= ResolveUrl("~/Content/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Assets/CSS/campusaid.css") %>?v=20261101" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="formStudent" runat="server">
        <asp:ScriptManager runat="server" />
        <div class="app-wrapper">
            <!-- Sidebar -->
            <aside class="app-sidebar">
                <div class="sidebar-brand">
                    <div class="brand-logo-row">
                        <div class="brand-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                        </div>
                        <span class="brand-text">CampusAid</span>
                    </div>
                    <span class="brand-portal-tag">CAMPUS SAFETY</span>
                </div>

                <nav class="sidebar-nav">
                    <a href="<%= ResolveUrl("~/Student/Dashboard.aspx") %>" class="nav-link-item <%= IsActive("Dashboard.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg></span> Home</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/SOS.aspx") %>" class="nav-link-item <%= IsActive("SOS.aspx") %>" style="color: #fca5a5;">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12a5 5 0 0 1 10 0v4H7v-4z"/><path d="M5 20h14"/><path d="M12 4V2"/><path d="M4 4l2 2"/><path d="M20 4l-2 2"/></svg></span> SOS</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/Resources.aspx") %>" class="nav-link-item <%= IsActive("Resources.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"/></svg></span> Resources</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/ReportIncident.aspx") %>" class="nav-link-item <%= IsActive("ReportIncident.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span> Report Incident</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/MyReports.aspx") %>" class="nav-link-item <%= IsActive("MyReports.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 12h6"/><path d="M9 16h6"/></svg></span> My Reports</span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/Alerts.aspx") %>" class="nav-link-item <%= IsActive("Alerts.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></span> Alerts</span>
                        <span class="nav-badge"><asp:Literal ID="litActiveAlertsCount" runat="server">3</asp:Literal></span>
                    </a>
                    <a href="<%= ResolveUrl("~/Student/Profile.aspx") %>" class="nav-link-item <%= IsActive("Profile.aspx") %>">
                        <span><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span> Profile</span>
                    </a>
                </nav>

                <div class="sidebar-user">
                    <div class="user-info">
                        <span class="user-name"><asp:Literal ID="litUserName" runat="server">Bokul Bormon</asp:Literal></span>
                        <span class="user-meta"><asp:Literal ID="litUserId" runat="server">ID: 2024-8941</asp:Literal></span>
                    </div>
                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="btn-sidebar-logout" OnClick="btnLogout_Click" CausesValidation="false" ToolTip="Sign Out">Log Out</asp:LinkButton>
                </div>
            </aside>

            <!-- Main Content Area -->
            <div class="app-main">
                <header class="app-header">
                    <div class="header-left">
                        <button type="button" id="mobileSidebarToggle" class="btn btn-sm btn-outline-secondary d-lg-none me-2" aria-label="Toggle navigation">
                            <svg class="ca-icon ca-icon-sm" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
                        </button>
                        <asp:ContentPlaceHolder ID="HeaderTitleContent" runat="server">
                            <h1>Student Dashboard</h1>
                            <p>Stay informed and safe on campus today.</p>
                        </asp:ContentPlaceHolder>
                    </div>
                    <div class="header-right">
                        <span class="status-pill status-normal">
                            <span class="status-dot"></span>
                            CAMPUS STATUS: NORMAL
                        </span>
                        <span class="hotline-badge">EXT. 9111</span>
                    </div>
                </header>

                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </main>
            </div>
        </div>
    </form>

    <script src="<%= ResolveUrl("~/Scripts/bootstrap.bundle.min.js") %>"></script>
    <script src="<%= ResolveUrl("~/Assets/JS/campusaid.js") %>"></script>
</body>
</html>
